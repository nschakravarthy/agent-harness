# Base URL for the backend API. Leave as-is to use the Vite dev proxy
# (recommended in development — see vite.config.ts). Set to an absolute
# URL like https://api.example.com/api/v1 for a deployed backend.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev proxy forwards /api requests. Only used in `npm run dev`.
VITE_API_TARGET=http://localhost:8000
