# Template for .env. Copy it and fill in real values:
#
#     cp .env.example .env
#
# .env itself is gitignored and excluded from the Docker build context, so
# secrets stay out of commits and out of image layers. This template is
# tracked deliberately (see the .env.example exemptions in .gitignore).

# Anthropic API key, from https://console.anthropic.com/settings/keys.
# Read from the environment by the Anthropic SDK at runtime - the provider in
# harness/providers/anthropic.py constructs Anthropic() with no explicit key.
# Supplied to containers by the `env_file` entries in docker-compose.yml.
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
